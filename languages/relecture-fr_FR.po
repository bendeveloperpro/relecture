#. Plugin Name of the plugin
#: relecture.php
msgid "Relecture"
msgstr "Relecture"

#. Plugin URI of the plugin
#: relecture.php
msgid "https://github.com/bendeveloperpro/relecture"
msgstr "https://github.com/bendeveloperpro/relecture"

#. Description of the plugin
#: relecture.php
msgid ""
"Proofread, correct and annotate posts and pages in a three-column table, "
"then export the review to Excel, CSV, Word, Markdown or JSON."
msgstr ""
"Relisez, corrigez et annotez articles et pages dans un tableau à trois "
"colonnes, puis exportez la relecture en Excel, CSV, Word, Markdown ou JSON."

